# Safe, non-secret configuration template. Copy to an untracked environment file.
# Runtime secrets and platform bindings must be injected by the deployment platform.
IBFT_ENVIRONMENT=development
IBFT_BUSINESS_TIMEZONE=Asia/Karachi
IBFT_CURRENCY=PKR
IBFT_FISCAL_YEAR_START_MONTH=7
IBFT_LOG_LEVEL=info
IBFT_READINESS_TIMEOUT_MS=2000
